# Copy to apps/web/.env.local and apps/api/.env (or root .env loaded by api)

# Supabase (nexus-core)
SUPABASE_URL=https://yrvdxofquvprklzsxoav.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API (Hono)
PORT=8787
# Allowed CORS origins (comma-separated for multiple).
CORS_ORIGIN=http://localhost:5173
# Canonical web-app origin the OAuth callback redirects back to after connecting a
# channel. Use a SINGLE url (not the CORS_ORIGIN list). Falls back to the first
# CORS_ORIGIN entry if unset. e.g. https://vantage.bioloopnexus.com
WEB_APP_URL=http://localhost:5173

# ── LLM providers (multi-model) ──────────────────────────────────────────────
# Configure any subset. Each task resolves to an ordered chain of provider:model
# slots; if one fails at runtime (rate limit, out of credits, overloaded) the next
# slot takes over automatically.
#
# Precedence, highest first:
#   1. per-workspace Settings (llm_provider_generate / llm_provider_audit)
#   2. LLM_POOL_GENERATE / LLM_POOL_AUDIT
#   3. LLM_PROVIDER_GENERATE / LLM_PROVIDER_AUDIT
#   4. LLM_POOL
#   5. LLM_PROVIDER
#   6. task default — generate (Kuze) → openai, audit (Ilita) → anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
# Gemini rides Google's OpenAI-compatibility endpoint — no extra SDK needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=
# XAI_* preferred; GROK_* still accepted as an alias.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=
# KIMI_* preferred; MOONSHOT_* still accepted as an alias.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=
#
# LEAVE LLM_PROVIDER EMPTY to get the per-task defaults above (Kuze → OpenAI,
# Ilita → Anthropic). Setting it pins BOTH tasks to one provider — this used to
# default to `anthropic`, which silently overrode the per-task defaults.
LLM_PROVIDER=
LLM_PROVIDER_GENERATE=
LLM_PROVIDER_AUDIT=
# Pools are comma-separated `provider` or `provider:model` entries, in failover
# order, e.g. LLM_POOL_GENERATE=openai:gpt-4o,anthropic:claude-sonnet-5
LLM_POOL=
LLM_POOL_GENERATE=
LLM_POOL_AUDIT=
# Slots attempted before giving up (default 3) — bounds worst-case latency.
LLM_MAX_ATTEMPTS=3

# ── Distribution channel OAuth ────────────────────────────────────────────────
# Redirect URIs must match the provider app config EXACTLY (lowercase slug, no
# trailing slash). In production use your API host, e.g.
# https://<your-api>/v1/channels/<slug>/auth/callback

# X (Twitter) OAuth 2.0 — user context for post + webhooks
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8787/v1/channels/x/auth/callback
# Webhook CRC / signature (OAuth 2.0 client secret often used for CRC per X docs)
X_WEBHOOK_SECRET=

# LinkedIn OAuth 2.0 (scopes: openid profile w_member_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/v1/channels/linkedin/auth/callback
LINKEDIN_WEBHOOK_SECRET=

# Reddit OAuth 2.0 — create a "web app" (has a secret) at reddit.com/prefs/apps.
# The App ID (string under the app name) is REDDIT_CLIENT_ID.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8787/v1/channels/reddit/auth/callback
# Reddit 403s generic User-Agents. Use its required format with YOUR username:
# "<platform>:<app id>:<version> (by /u/<your reddit username>)"
REDDIT_USER_AGENT=web:vantage:1.0.0 (by /u/your_reddit_username)
# Reddit hard-blocks datacenter IPs (Railway/GCP) at its edge → 403. If blocked,
# route Reddit calls through a residential/clean-IP proxy. Leave empty otherwise.
# Format: http://user:pass@host:port
REDDIT_PROXY_URL=

# Threads (Meta Graph API) OAuth 2.0 (scopes: threads_basic threads_content_publish)
# Threads authorizes on threads.net and validates the callback against the Threads
# use case's own "Redirect Callback URLs" field — NOT the Facebook Login one below.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:8787/v1/channels/threads/auth/callback

# TikTok OAuth 2.0 + PKCE. Note the id var is CLIENT_KEY (TikTok's naming), not CLIENT_ID.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8787/v1/channels/tiktok/auth/callback

# ── Meta (Facebook Login) — Instagram + Facebook Page ────────────────────────
# Both channels run through the SAME Meta app and the same facebook.com/dialog/oauth
# endpoint, so INSTAGRAM_CLIENT_ID and FACEBOOK_CLIENT_ID are usually the same App ID.
#
# IMPORTANT — the redirect URIs below must be listed VERBATIM (both of them, as two
# separate entries) under Meta app → Products → Facebook Login → Settings → "Valid
# OAuth Redirect URIs". Setting "App Domains" in Settings → Basic does NOT allowlist
# them; if they're missing, Meta shows the misleading "Can't load URL: the domain of
# this URL isn't included in the app's domains" dialog. Also confirm "Client OAuth
# login" and "Web OAuth login" are both toggled on in that same panel.
#
# Instagram additionally requires a Business/Creator IG account linked to a Facebook
# Page you admin — a personal account consents fine, then fails account resolution.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8787/v1/channels/instagram/auth/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8787/v1/channels/facebook/auth/callback

# Bluesky (AT Protocol) — connected per-workspace in the UI with a handle + app
# password; no app credentials needed. Override the PDS only when self-hosting.
# BLUESKY_PDS_URL=https://bsky.social

# Email (Resend) — the email channel adapter + webhook. Configured by env only:
# there's no per-workspace connect flow, so the Channels tile stays "Not connected"
# even when these are set. Sending still works.
# The from-address var is RESEND_FROM_ADDRESS (adapters/email.ts, lib/alert.ts).
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=
# RESEND_WEBHOOK_SECRET=
# Optional: destination for ops alerts (needs RESEND_API_KEY + RESEND_FROM_ADDRESS).
# ALERT_EMAIL=

# ── DemoForge worker (apps/demoforge — separate Railway service) ─────────────
# DEMOFORGE_URL is set on vantage-api so it can enqueue jobs.
DEMOFORGE_URL=http://localhost:8788
DEMOFORGE_SECRET=
# Narration TTS — must be on the DemoForge service. Without this key, campaign
# demo videos still render but are silent (no voiceover).
ELEVENLABS_API_KEY=
# Optional: DEMOFORGE_TTS_PROVIDER=voicebox  (local Qwen3-TTS instead of ElevenLabs)
# SHIFT_BASE_URL=https://theshift.bioloopnexus.com

# Web SPA (Vite — build-time)
VITE_SUPABASE_URL=https://yrvdxofquvprklzsxoav.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_VANTAGE_API_URL=http://localhost:8787
# Nexus SSO app URL — unauthenticated users are redirected here to sign in.
# BioLoop suite shares the nexus-core Supabase; Nexus returns the session in the URL hash.
VITE_NEXUS_AUTH_URL=https://your-nexus-sso.example.com
